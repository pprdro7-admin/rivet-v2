From: Claude <noreply@anthropic.com>
Date: Tue, 3 Nov 2026 07:56:28 +0000
Subject: [PATCH 1/3] School page: Pre-filled NSBI form button once the school
 is Complete (the form itself opens only after the Division is cleared)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_015FZpUfYQMUaz2Hya5AmveL
---
 web/src/screens/School.jsx | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/web/src/screens/School.jsx b/web/src/screens/School.jsx
index f8ebdc6..b185299 100644
--- a/web/src/screens/School.jsx
+++ b/web/src/screens/School.jsx
@@ -222,7 +222,7 @@ export default function School({ db, me, schoolId }) {
       {!isSchool && <a href={`#/sdo/${t.sdo_code}`} className="small">← Validation</a>}
       <div className="spread">
         <div><h1>{t.school_name}</h1><span className="mono muted">{t.school_id} · {t.district}</span><div className="small muted">{SOURCE}, with the SDO's validation</div></div>
-        {t.dpo_complete ? <span className="chip green">Complete</span>
+        {t.dpo_complete ? <div className="btns"><span className="chip green">Complete</span><a className="btn sm secondary" href={`#/form/${t.school_id}`}>Pre-filled NSBI form</a></div>
           : t.dpo_result === 'returned' ? <span className="chip amber">Returned to DE</span> : null}
       </div>
 
